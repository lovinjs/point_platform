# Copy to backend.env on the server; chmod 600. Never commit the real file.
# Compose reads this file in raw mode: do not add quotes around values.
# Dollar signs and # characters inside values are preserved literally.

# Use 1Panel's internal container hostname/alias and INTERNAL MySQL port.
# With MySQL 8.4's caching_sha2_password, use TLS even on the container network.
# REQUIRED encrypts the connection but does not verify server identity.
# Before public use, upgrade to VERIFY_IDENTITY with a trusted server certificate.
DB_URL=jdbc:mysql://1Panel-mysql-UviB:3306/point_platform?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&sslMode=REQUIRED&rewriteBatchedStatements=true
DB_USERNAME=point_platform_app
DB_PASSWORD=

REDIS_HOST=1Panel-redis-3ZpE
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate two independent Base64-encoded random values (at least 32 bytes each).
# Keep these configured after the initial super-admin has been created.
PLATFORM_ADMIN_JWT_SECRET_BASE64=
PLATFORM_CUSTOMER_JWT_SECRET_BASE64=

# Enable only for the first start, then disable and clear bootstrap credentials.
PLATFORM_BOOTSTRAP_ADMIN_ENABLED=false
PLATFORM_BOOTSTRAP_ADMIN_USERNAME=
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=
PLATFORM_BOOTSTRAP_ADMIN_REAL_NAME=
PLATFORM_BOOTSTRAP_ADMIN_PHONE=

# Keep disabled until this environment's WeChat account and HTTPS callback are configured.
# Staging currently uses the original test account, not the formal service account.
PLATFORM_WECHAT_H5_ENABLED=false
PLATFORM_WECHAT_H5_APP_ID=
PLATFORM_WECHAT_H5_APP_SECRET=
PLATFORM_WECHAT_H5_CALLBACK_URL=
PLATFORM_H5_BASE_URL=
PLATFORM_WECHAT_H5_SCOPE=snsapi_userinfo

# Start with DISABLED. Configure ALIYUN deliberately when ready to send real SMS.
# LOG is prohibited in the prod profile.
PLATFORM_PHONE_VERIFICATION_MODE=DISABLED
# Conservative staging quota; this counter expires 24 hours after its first request.
PLATFORM_PHONE_VERIFICATION_GLOBAL_DAILY_LIMIT=50
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
PLATFORM_SMS_ALIYUN_SIGN_NAME=
PLATFORM_SMS_ALIYUN_TEMPLATE_CODE=
